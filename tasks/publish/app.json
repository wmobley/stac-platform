{
  "id": "stac-publish",
  "version": "0.1.0",
  "description": "Dual-write a granule's artifacts to CKAN (asset store) and the STAC API (Transactions). Reusable across projects.",
  "owner": "${apiUserId}",
  "enabled": true,
  "runtime": "SINGULARITY",
  "runtimeVersion": null,
  "runtimeOptions": ["SINGULARITY_RUN"],
  "containerImage": "docker://ghcr.io/wmobley/stac-publish:latest",
  "jobType": "BATCH",
  "maxJobs": -1,
  "maxJobsPerUser": -1,
  "strictFileInputs": false,
  "jobAttributes": {
    "description": "Publish one granule to CKAN + STAC.",
    "dynamicExecSystem": false,
    "execSystemId": "ls6",
    "execSystemExecDir": "${JobWorkingDir}",
    "execSystemInputDir": "${JobWorkingDir}/inputs",
    "execSystemOutputDir": "${JobWorkingDir}/output",
    "execSystemLogicalQueue": "vm-small",
    "archiveSystemId": "cloud.data",
    "archiveSystemDir": "HOST_EVAL($HOME)/tapis-jobs-archive/${JobCreateDate}/${JobName}-${JobUUID}",
    "archiveOnAppError": true,
    "cmdPrefix": "mkdir -p $PWD/inputs $PWD/output;",
    "parameterSet": {
      "schedulerOptions": [
        {
          "name": "TACC Scheduler Profile",
          "inputMode": "FIXED",
          "arg": "--tapis-profile tacc-apptainer",
          "notes": {"isHidden": true}
        },
        {
          "name": "TACC Allocation",
          "description": "TACC allocation charged for the publish job.",
          "inputMode": "INCLUDE_ON_DEMAND",
          "arg": null,
          "notes": {"isHidden": true}
        }
      ],
      "envVariables": [
        {"key": "COLLECTION", "value": "subsidence-rates", "inputMode": "REQUIRED",
         "description": "CKAN dataset = STAC Collection id.", "notes": {"label": "Collection id"}},
        {"key": "ITEM_ID", "value": "", "inputMode": "REQUIRED",
         "description": "STAC Item id (also the stac_item_id on resources).", "notes": {"label": "Item id"}},
        {"key": "CKAN_URL", "value": "https://ckan.tacc.utexas.edu", "inputMode": "INCLUDE_BY_DEFAULT",
         "notes": {"label": "CKAN URL"}},
        {"key": "CKAN_TOKEN", "value": "", "inputMode": "REQUIRED",
         "description": "CKAN API token with write access to CKAN_ORG.", "notes": {"label": "CKAN token"}},
        {"key": "CKAN_ORG", "value": "", "inputMode": "REQUIRED",
         "description": "CKAN organization owning the dataset.", "notes": {"label": "CKAN org"}},
        {"key": "STAC_URL", "value": "https://stac-api.pods.portals.tapis.io", "inputMode": "INCLUDE_BY_DEFAULT",
         "notes": {"label": "STAC API URL"}},
        {"key": "STAC_TOKEN", "value": "", "inputMode": "INCLUDE_ON_DEMAND",
         "description": "Bearer token for the STAC Transactions extension (if writes are protected)."},
        {"key": "COLLECTION_TITLE", "value": "", "inputMode": "INCLUDE_ON_DEMAND"},
        {"key": "COLLECTION_DESCRIPTION", "value": "", "inputMode": "INCLUDE_ON_DEMAND"}
      ],
      "archiveFilter": {"includes": [], "excludes": [], "includeLaunchFiles": true}
    },
    "fileInputs": [
      {"name": "manifest", "description": "SUBSIDE run manifest JSON.", "inputMode": "REQUIRED",
       "autoMountLocal": true, "sourceUrl": null, "targetPath": "inputs/manifest.json"},
      {"name": "cog", "description": "Displacement COG (.tif).", "inputMode": "OPTIONAL",
       "autoMountLocal": true, "sourceUrl": null, "targetPath": "inputs/displacement.tif"},
      {"name": "overlay", "description": "PNG overlay quick-look.", "inputMode": "OPTIONAL",
       "autoMountLocal": true, "sourceUrl": null, "targetPath": "inputs/overlay.png"}
    ],
    "fileInputArrays": [],
    "nodeCount": 1,
    "coresPerNode": 1,
    "memoryMB": 2048,
    "maxMinutes": 30,
    "subscriptions": [],
    "tags": []
  },
  "tags": ["stac", "ckan", "publish"],
  "notes": {
    "label": "STAC + CKAN Publish",
    "isInteractive": false,
    "icon": "publish",
    "category": "Data Processing",
    "queueFilter": ["vm-small", "development"]
  }
}
