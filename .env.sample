# stac-platform configuration. Copy to .env (gitignored). Every value is also a
# plain environment variable, so pods/CI can set them directly.

# --- PgSTAC Postgres (the STAC API + bridge talk to this) ---------------------
# On Tapis this is a Postgres pod reached over the pods 443 TLS-SNI tunnel.
# pypgstac/psycopg read the standard PG* split vars; sslnegotiation=direct is
# REQUIRED for libpq >= 17 against the pods tunnel (same as SUBSIDE's PostGIS).
PGHOST=stacpostgres.pods.portals.tapis.io
PGPORT=443
PGDATABASE=stac
PGUSER=stac
PGPASSWORD=change-me
PGSSLMODE=require
PGSSLNEGOTIATION=direct

# --- STAC API service ---------------------------------------------------------
STAC_API_TITLE=TACC STAC API
STAC_API_DESCRIPTION=Spatiotemporal catalog beside CKAN
# API serves under this prefix; the React viewer is served at "/".
PREFIX_PATH=/api/v1
# CORS origins for the vite dev server (same-origin in prod).
STAC_CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Writes (Transactions) require a valid Tapis token, validated against this tenant.
TAPIS_BASE_URL=https://portals.tapis.io
# STAC_AUTH_DISABLED=true   # local dev only: open writes (no token required)

# --- CKAN (asset store + human catalog) ---------------------------------------
CKAN_URL=https://ckan.tacc.utexas.edu
# Publish uses the user's own Tapis token as the CKAN token; leave blank here.
CKAN_TOKEN=
# CKAN organization that owns published datasets (must exist / be writable).
CKAN_ORG=tacc-water

# --- publish target (where the dual-write step PUTs the STAC Item) -------------
# Note the /api/v1 prefix. STAC_TOKEN is a Tapis token (set automatically by the
# orchestrator to the user's token; fill only for manual CLI publishing).
STAC_URL=http://localhost:8081/api/v1
STAC_TOKEN=
