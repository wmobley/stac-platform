# stac-platform configuration. Copy to .env (gitignored). Every value is also a
# plain environment variable, so pods/CI can set them directly.

# --- PgSTAC Postgres (the STAC API + bridge talk to this) ---------------------
# On Tapis this is a Postgres pod reached over the pods 443 TLS-SNI tunnel.
# pypgstac/psycopg read the standard PG* split vars; sslnegotiation=direct is
# REQUIRED for libpq >= 17 against the pods tunnel (same as SUBSIDE's PostGIS).
PGHOST=stacpostgres.pods.portals.tapis.io
PGPORT=443
PGDATABASE=stac
PGUSER=stac
PGPASSWORD=change-me
PGSSLMODE=require
PGSSLNEGOTIATION=direct

# --- STAC API service ---------------------------------------------------------
STAC_API_TITLE=TACC STAC API
STAC_API_DESCRIPTION=Spatiotemporal catalog beside CKAN
# Public base URL the API advertises in self/root links (no trailing slash).
STAC_API_ROOT_PATH=
# Comma-separated CORS origins allowed to call the API from a browser.
STAC_CORS_ORIGINS=http://localhost:5174,http://localhost:8081
# Write protection for the Transactions extension. When set, POST/PUT/DELETE on
# collections/items require `Authorization: Bearer <token>`; reads stay public.
# Leave unset ONLY for local dev.
STAC_WRITE_TOKEN=

# --- CKAN (asset store + human catalog) ---------------------------------------
CKAN_URL=https://ckan.tacc.utexas.edu
CKAN_TOKEN=change-me
# CKAN organization that owns published datasets (must exist / be writable).
CKAN_ORG=tacc-water

# --- publish task target (where it writes the STAC Item) ----------------------
# The STAC API base URL the publish task PUTs items to, plus its write token.
STAC_URL=http://localhost:8081
STAC_TOKEN=
